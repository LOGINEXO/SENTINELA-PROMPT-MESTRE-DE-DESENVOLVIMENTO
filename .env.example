# Optional local configuration examples only.
SENTINELA_ENV=development
SENTINELA_LOG_LEVEL=INFO
SENTINELA_CONFIG_PATH=config/settings.example.json
SENTINELA_REPORTS_DIR=reports

# The PHP interface is local-only and has no login/account system.
# Start the built-in server on 127.0.0.1; do not expose it to a network.
SENTINELA_LOCAL_MODE=1
