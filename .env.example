# Example only. Do not put real secrets in this file.
SENTINELA_ENV=development
SENTINELA_LOG_LEVEL=INFO
SENTINELA_CONFIG_PATH=config/settings.example.json
SENTINELA_REPORTS_DIR=reports

# Required by the PHP panel. Set these in the web/PHP process environment;
# PHP does not load this file automatically. Use a unique password of 16+ chars.
SENTINELA_WEB_USERNAME=replace-with-a-private-admin-username
SENTINELA_WEB_PASSWORD=replace-with-a-unique-secret-of-at-least-16-characters
