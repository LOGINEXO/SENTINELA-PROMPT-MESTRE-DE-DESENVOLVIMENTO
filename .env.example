# Example only. Do not put real secrets in this file.
SENTINELA_ENV=development
SENTINELA_LOG_LEVEL=INFO
SENTINELA_CONFIG_PATH=config/settings.example.json
SENTINELA_REPORTS_DIR=reports

# Local-only convenience: set to 1 only when php -S binds to 127.0.0.1.
# Never use this mode with a public server, reverse proxy, tunnel, or container port.
# PHP does not load this file automatically; set variables in the process environment.
SENTINELA_LOCAL_MODE=0

# Required for remote/networked deployments. Use a unique password of 16+ chars.
SENTINELA_WEB_USERNAME=replace-with-a-private-admin-username
SENTINELA_WEB_PASSWORD=replace-with-a-unique-secret-of-at-least-16-characters
